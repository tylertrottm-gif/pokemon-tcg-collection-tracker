# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml file to GitHub.

[pokemon_tcg]
api_key = "your-pokemon-tcg-api-key"

[supabase]
url = "https://your-project.supabase.co"
key = "your-supabase-anon-key"

[app]
# Optional. Leave blank to disable the in-app PIN screen.
owner_pin = "choose-a-private-pin"
